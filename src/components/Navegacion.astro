---
import { getRelativeLocaleUrl } from 'astro:i18n';
import sitio from '../lib/sitio';
import { ruta } from '../lib/planes';
import { t, locales, type Locale } from '../lib/i18n';
interface Props { locale: Locale; pagina?: string; }
const { locale, pagina = '/' } = Astro.props;
const i = t(locale);
const inicio = pagina === '/' ? '' : getRelativeLocaleUrl(locale, '/');
const quienesFrase = (locale === 'ca' && sitio.quienesFrase_ca) || (locale === 'en' && sitio.quienesFrase_en) || sitio.quienesFrase;
---
  <nav class="nav" aria-label={i.navPrincipal}>
    <a href={getRelativeLocaleUrl(locale, '/')}><img class="nav-monograma" src={ruta('/logos/monograma.png')} alt={i.inicioAlt}></a>
    <ul class="nav-secciones">
      <li><a href={`${inicio}#planes`}>{i.menuPlanes}</a></li>
      {quienesFrase && <li><a href={`${inicio}#quienes-somos`}>{i.menuNosotras}</a></li>}
      <li><a href={`${inicio}#participar`}>{i.menuParticipar}</a></li>
    </ul>
    <div class="nav-derecha">
      <ul class="nav-idiomas" aria-label="Idioma / Language">
        {locales.map((l) => (
          <li>
            {l === locale
              ? <span aria-current="true">{l.toUpperCase()}</span>
              : <a href={getRelativeLocaleUrl(l, pagina)} lang={l} hreflang={l}>{l.toUpperCase()}</a>}
          </li>
        ))}
      </ul>
      {sitio.instagram && (
        <a class="nav-ig" href={sitio.instagram} target="_blank" rel="noopener" aria-label={i.igAria}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      )}
    </div>
  </nav>
