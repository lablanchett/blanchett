---
import sitio from '../lib/sitio';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const i = t(locale);
---
<footer class="pie contenedor">
  <span>© {new Date().getFullYear()} La Blanchett</span>
  <nav aria-label={i.redesContacto}>
    {sitio.instagram && (
      <a class="nav-ig" href={sitio.instagram} target="_blank" rel="noopener" aria-label={i.igAria}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
    )}
  </nav>
</footer>
