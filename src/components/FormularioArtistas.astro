---
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const i = t(locale);
const formulario = 'https://tally.so/r/jeaVy1';
Astro.csp?.insertDirective('frame-src https://tally.so');
Astro.csp?.insertScriptResource('https://tally.so/widgets/embed.js');
// Hoja de estilos que inserta el widget para redimensionar el formulario.
Astro.csp?.insertStyleHash('sha256-3PQtmxQ/BySEL2pnhMPLSakz2xyTEZib3L6jthOOr6s=');
---
      <div class="artistas-alternativa">
        {locale !== 'es' && <span>{i.artistasIdioma}</span>}
        <a href={formulario} target="_blank" rel="noopener">{i.artistasAbrir} ↗</a>
      </div>
      <div class="artistas-formulario">
        <iframe
          data-formulario-src="https://tally.so/embed/jeaVy1?alignLeft=1&hideTitle=1&dynamicHeight=1"
          hidden
          width="100%"
          height="1050"
          title={i.artistasTitulo}
          loading="lazy"
        ></iframe>
      </div>
<script>
  for (const iframe of document.querySelectorAll<HTMLIFrameElement>('iframe[data-formulario-src]')) {
    const desplegable = iframe.closest('details');
    const cargar = () => {
      if ((desplegable && !desplegable.open) || iframe.hasAttribute('src')) return;
      iframe.src = iframe.dataset.formularioSrc!;
      iframe.hidden = false;
      if (!document.querySelector('script[src="https://tally.so/widgets/embed.js"]')) {
        const script = document.createElement('script');
        script.src = 'https://tally.so/widgets/embed.js';
        script.async = true;
        document.head.append(script);
      }
    };
    desplegable?.addEventListener('toggle', cargar);
    cargar();
  }
</script>
